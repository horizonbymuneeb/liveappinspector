root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.rs]
max_line_length = 100

[*.{png,jpg,ico,exe,zip}]
insert_final_newline = false
